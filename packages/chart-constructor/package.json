{
  "name": "chart-constructor",
  "version": "0.1.0",
  "description": "基于 React 与 ECharts 的图表构造器组件，支持配置项编辑、实时预览与配置导出",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css", "**/*.less"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "keywords": ["react", "echarts", "chart", "constructor"],
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "antd": "^5.19.0",
    "echarts": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "ahooks": "^3.8.0"
  },
  "devDependencies": {
    "@chart-constructor/eslint-config": "workspace:*",
    "@chart-constructor/tsconfig": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "antd": "^5.19.1",
    "echarts": "^5.5.1",
    "eslint": "^8.57.0",
    "less": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^4.0.3"
  }
}

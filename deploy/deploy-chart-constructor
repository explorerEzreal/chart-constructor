#!/usr/bin/env bash
# chart-constructor 服务器发布：接收 CI 静态产物并原子切换版本，保留旧构建方式作为迁移回退
set -Eeuo pipefail
umask 022

APP_NAME="chart-constructor"
ROOT_DIR="/srv/chart-constructor"
REPO_DIR="${ROOT_DIR}/repo.git"
RELEASES_DIR="${ROOT_DIR}/releases"
CURRENT_LINK="${ROOT_DIR}/current"
PREVIOUS_LINK="${ROOT_DIR}/previous"
REPOSITORY_URL="https://github.com/explorerEzreal/chart-constructor.git"
BRANCH="master"
HEALTH_URL="https://chart.supershiba.cn"
KEEP_RELEASES="${KEEP_RELEASES:-5}"
PNPM_VERSION="${PNPM_VERSION:-11.25.0}"
LOCK_FILE="${ROOT_DIR}/.deploy.lock"
TMP_DIR=""
ARCHIVE_TMP=""

log() {
  printf '[%s] %s\n' "$(date '+%F %T')" "$*"
}

fail() {
  log "错误：$*"
  exit 1
}

cleanup() {
  if [[ -n "${TMP_DIR}" && -d "${TMP_DIR}" ]]; then
    rm -rf "${TMP_DIR}"
  fi
  if [[ -n "${ARCHIVE_TMP}" && -f "${ARCHIVE_TMP}" ]]; then
    rm -f "${ARCHIVE_TMP}"
  fi
}
trap cleanup EXIT

validate_sha() {
  [[ "${1:-}" =~ ^[0-9a-f]{40}$ ]] || fail "提交 SHA 格式不正确"
}

ensure_repo() {
  if [[ ! -d "${REPO_DIR}" ]]; then
    git init --bare "${REPO_DIR}" >/dev/null
  fi
  git --git-dir="${REPO_DIR}" remote set-url origin "${REPOSITORY_URL}"
}

fetch_branch() {
  git --git-dir="${REPO_DIR}" fetch --prune --no-tags origin "+refs/heads/${BRANCH}:refs/heads/${BRANCH}"
}

validate_branch_commit() {
  local sha="$1"
  git --git-dir="${REPO_DIR}" merge-base --is-ancestor "${sha}" "refs/heads/${BRANCH}" \
    || fail "提交不在 ${BRANCH} 分支历史中"
}

activate_release() {
  local target="$1"
  ln -sfn "${target}" "${ROOT_DIR}/.current.new"
  mv -Tf "${ROOT_DIR}/.current.new" "${CURRENT_LINK}"
}

set_previous_release() {
  local target="$1"
  if [[ -z "${target}" || ! -d "${target}" ]]; then
    return 0
  fi
  ln -sfn "${target}" "${ROOT_DIR}/.previous.new"
  mv -Tf "${ROOT_DIR}/.previous.new" "${PREVIOUS_LINK}"
}

current_release() {
  if [[ -L "${CURRENT_LINK}" ]]; then
    readlink -f "${CURRENT_LINK}"
  fi
}

previous_release() {
  if [[ -L "${PREVIOUS_LINK}" ]]; then
    readlink -f "${PREVIOUS_LINK}"
  fi
}

health_check() {
  local path status
  for path in / /demo /guide; do
    status="$(curl -sS -o /dev/null -w '%{http_code}' -m 5 \
      --resolve chart.supershiba.cn:443:127.0.0.1 "${HEALTH_URL}${path}" 2>/dev/null || true)"
    if [[ "${status}" != "200" ]]; then
      log "健康检查失败：${HEALTH_URL}${path} 返回 ${status:-无响应}"
      return 1
    fi
  done
  return 0
}

prune_releases() {
  local current_target previous_target count=0 dir
  current_target="$(current_release)"
  previous_target="$(previous_release)"

  while IFS= read -r dir; do
    [[ -z "${dir}" ]] && continue
    count=$((count + 1))
    if [[ "${dir}" == "${current_target}" || "${dir}" == "${previous_target}" || ${count} -le ${KEEP_RELEASES} ]]; then
      continue
    fi
    rm -rf "${dir}"
  done < <(find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' | sort -rn | cut -d' ' -f2-)
}

restore_after_failed_health() {
  local fallback="$1"
  if [[ -z "${fallback}" || ! -d "${fallback}" ]]; then
    rm -f "${CURRENT_LINK}"
    fail "首次发布健康检查失败，没有可回滚版本"
  fi

  log "健康检查失败，正在回滚到 ${fallback}"
  activate_release "${fallback}"
  health_check || fail "回滚后健康检查仍然失败"
  fail "发布失败，已回滚到上一版本"
}

validate_archive() {
  local archive="$1"
  local entries
  [[ -s "${archive}" ]] || fail "未收到静态产物"
  gzip -t "${archive}" >/dev/null 2>&1 || fail "静态产物不是有效的 tar.gz"

  entries="$(tar -tzf "${archive}")"
  if printf '%s\n' "${entries}" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then
    fail "静态产物包含非法路径"
  fi
  if ! printf '%s\n' "${entries}" | sed 's#^\./##' | grep -qx 'index.html'; then
    fail "静态产物缺少 index.html"
  fi
  if ! printf '%s\n' "${entries}" | sed 's#^\./##' | grep -qx '.deploy-sha'; then
    fail "静态产物缺少 .deploy-sha"
  fi
}

publish() {
  local sha="${1:-}"
  local current_target release_dir artifact_sha
  validate_sha "${sha}"
  command -v tar >/dev/null 2>&1 || fail "缺少 tar"
  command -v gzip >/dev/null 2>&1 || fail "缺少 gzip"
  command -v curl >/dev/null 2>&1 || fail "缺少 curl"

  mkdir -p "${RELEASES_DIR}"
  exec 9>"${LOCK_FILE}"
  flock -n 9 || fail "已有发布任务正在执行"

  current_target="$(current_release)"

  ARCHIVE_TMP="$(mktemp "${ROOT_DIR}/.artifact-${sha:0:12}.XXXXXX")"
  log "接收静态产物 ${sha}"
  cat > "${ARCHIVE_TMP}"
  validate_archive "${ARCHIVE_TMP}"

  if [[ -n "${current_target}" && -f "${current_target}/.deploy-sha" ]] \
      && [[ "$(cat "${current_target}/.deploy-sha")" == "${sha}" ]]; then
    log "当前版本已是 ${sha}，执行幂等健康检查"
    health_check || restore_after_failed_health "$(previous_release)"
    log "发布成功：${sha}"
    return 0
  fi

  TMP_DIR="$(mktemp -d "${ROOT_DIR}/.publish-${sha:0:12}.XXXXXX")"
  tar -xzf "${ARCHIVE_TMP}" -C "${TMP_DIR}"

  [[ -f "${TMP_DIR}/index.html" ]] || fail "静态产物缺少 index.html"
  [[ -f "${TMP_DIR}/.deploy-sha" ]] || fail "静态产物缺少 .deploy-sha"
  artifact_sha="$(tr -d '\r\n' < "${TMP_DIR}/.deploy-sha")"
  [[ "${artifact_sha}" == "${sha}" ]] || fail "静态产物 SHA 与发布参数不一致"

  release_dir="${RELEASES_DIR}/${sha:0:12}-$(date '+%Y%m%d%H%M%S')-$$"
  mv "${TMP_DIR}" "${release_dir}"
  TMP_DIR=""
  chmod -R a+rX "${release_dir}"

  log "切换版本到 ${release_dir}"
  activate_release "${release_dir}"

  if health_check; then
    set_previous_release "${current_target}"
    prune_releases
    log "发布成功：${sha}"
    return 0
  fi

  restore_after_failed_health "${current_target}"
}

deploy() {
  local sha="${1:-}"
  local current_target release_dir pnpm_bin
  validate_sha "${sha}"
  command -v git >/dev/null 2>&1 || fail "缺少 git"
  command -v curl >/dev/null 2>&1 || fail "缺少 curl"
  command -v pnpm >/dev/null 2>&1 || fail "缺少 pnpm ${PNPM_VERSION}"
  pnpm_bin="$(command -v pnpm)"
  [[ "$(${pnpm_bin} --version 2>/dev/null | tail -n 1)" == "${PNPM_VERSION}" ]] \
    || fail "pnpm 版本不是 ${PNPM_VERSION}"

  mkdir -p "${RELEASES_DIR}"
  exec 9>"${LOCK_FILE}"
  flock -n 9 || fail "已有发布任务正在执行"

  ensure_repo
  fetch_branch
  validate_branch_commit "${sha}"
  current_target="$(current_release)"

  if [[ -n "${current_target}" && -f "${current_target}/.deploy-sha" ]] \
      && [[ "$(cat "${current_target}/.deploy-sha")" == "${sha}" ]]; then
    log "当前版本已是 ${sha}，执行幂等健康检查"
    health_check || restore_after_failed_health "$(previous_release)"
    log "发布成功：${sha}"
    return 0
  fi

  TMP_DIR="$(mktemp -d "${ROOT_DIR}/.build-${sha:0:12}.XXXXXX")"
  log "导出提交 ${sha}"
  git --git-dir="${REPO_DIR}" archive --format=tar "${sha}" | tar -xf - -C "${TMP_DIR}"

  log "安装依赖"
  (cd "${TMP_DIR}" && pnpm install --frozen-lockfile)

  log "类型检查"
  (cd "${TMP_DIR}" && pnpm typecheck)

  log "代码规范检查"
  (cd "${TMP_DIR}" && pnpm lint)

  log "构建 playground"
  (cd "${TMP_DIR}" && pnpm build)

  [[ -f "${TMP_DIR}/apps/playground/dist/index.html" ]] || fail "构建产物缺少 apps/playground/dist/index.html"

  release_dir="${RELEASES_DIR}/${sha:0:12}-$(date '+%Y%m%d%H%M%S')-$$"
  mkdir -p "${release_dir}"
  cp -a "${TMP_DIR}/apps/playground/dist/." "${release_dir}/"
  printf '%s\n' "${sha}" > "${release_dir}/.deploy-sha"
  chmod -R a+rX "${release_dir}"

  log "切换版本到 ${release_dir}"
  activate_release "${release_dir}"

  if health_check; then
    set_previous_release "${current_target}"
    prune_releases
    log "发布成功：${sha}"
    return 0
  fi

  restore_after_failed_health "${current_target}"
}

rollback() {
  local current_target previous_target
  exec 9>"${LOCK_FILE}"
  flock -n 9 || fail "已有发布任务正在执行"

  current_target="$(current_release)"
  previous_target="$(previous_release)"
  [[ -n "${current_target}" && -d "${current_target}" ]] || fail "当前版本不存在"
  [[ -n "${previous_target}" && -d "${previous_target}" ]] || fail "上一版本不存在"

  log "回滚到 ${previous_target}"
  activate_release "${previous_target}"
  if health_check; then
    set_previous_release "${current_target}"
    prune_releases
    log "回滚成功"
    return 0
  fi

  activate_release "${current_target}"
  health_check || fail "回滚失败，当前版本也无法恢复"
  fail "回滚失败，已恢复当前版本"
}

mkdir -p "${ROOT_DIR}" "${RELEASES_DIR}"

command="${SSH_ORIGINAL_COMMAND:-}"
case "${command}" in
  publish\ *) publish "${command#publish }" ;;
  deploy\ *) deploy "${command#deploy }" ;;
  rollback) rollback ;;
  *) fail "不允许的命令" ;;
esac
